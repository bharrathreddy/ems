# ---------------------------------------------------------------
# Copy this file to ".env" in the project root.
# Values below match a default XAMPP install (MariaDB, user root, no password).
# On Hostinger, enter the same names in hPanel > Environment variables instead.
# ---------------------------------------------------------------

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ems
DB_USER=root
DB_PASSWORD=

# App
PORT=3000
APP_URL=http://localhost:5173
# Key that signs logins. Leave empty and the app makes a random one in the storage folder,
# or paste 40+ random characters of your own. Never share it, never use an example value.
JWT_ACCESS_SECRET=
# Secure cookies turn on by themselves when APP_URL starts with https://
COOKIE_SECURE=

# Creates tables and default data automatically when the app starts
AUTO_MIGRATE=true

# First run only: your developer (Super Admin) login and the school name
SEED_INSTITUTION_NAME=Sri Vidya High School
SEED_SUPERADMIN_EMAIL=dev@example.com
# ChangeMe@123 works for the first sign-in only: the app then asks you to choose a new password.
SEED_SUPERADMIN_PASSWORD=ChangeMe@123

# Show API documentation at /api/docs (keep false in production)
API_DOCS=false

# Where uploaded files (Excel imports, later photos and documents) are kept.
# Local: leave empty (uses the "storage" folder in the project).
# Hostinger: use a folder OUTSIDE the app so redeploys do not delete it, e.g. /home/u123456789/ems-storage
STORAGE_DIR=

# Demo website only (never for a real school): fill an EMPTY database with the demo school on start.
# DEMO_DATA=yes
